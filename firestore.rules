rules_version = '2';

// Agri-Share Firestore rules (production)
// - Anyone can browse approved machine listings and the diesel / province settings.
// - Bookings, live requests, Agri-Market posts, waiting demand and member profiles contain
//   names and phone numbers, so only signed-in members can read or write them.
// - Members can only create or edit their own profile.
// - Admin settings, the admin password hash, the team list and listing approval are
//   restricted to the founder (and team admins the founder authorises).
//   Admin emails must be verified, so nobody can claim the founder's address by
//   registering it with an unverified password account.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function smallDoc() { return request.resource.data.size() < 80; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    function isFounder() {
      return verified() && request.auth.token.email == '00talhashoaib786@gmail.com';
    }
    function teamDoc() { return /databases/$(database)/documents/admin_settings/team; }
    function isTeamAdmin() {
      return verified() && exists(teamDoc())
        && request.auth.token.email.lower() in get(teamDoc()).data.emails;
    }
    function isAdmin() { return isFounder() || isTeamAdmin(); }

    match /machinery_listings/{id} {
      allow read: if true;
      // owners submit listings as "pending"; only admins can approve or reject
      allow create: if signedIn() && smallDoc() && (isAdmin() || request.resource.data.status == 'pending');
      allow update: if signedIn() && smallDoc() && (isAdmin()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewedAt']));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('ownerEmail', '') == request.auth.token.email);
    }

    // admin_settings/pilot    diesel rate and active provinces (admins write)
    // admin_settings/security admin password hash (admins read, founder writes)
    // admin_settings/team     authorised team admin emails (signed-in read, founder writes)
    match /admin_settings/{id} {
      allow read: if (id == 'security' && isAdmin())
        || (id == 'team' && signedIn())
        || !(id in ['security', 'team']);
      allow write: if smallDoc() && (
        (id in ['security', 'team'] && isFounder())
        || (!(id in ['security', 'team']) && isAdmin()));
    }

    match /bookings/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && smallDoc();
    }
    match /indrive_requests/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && smallDoc();
    }
    match /mandi_crops/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && smallDoc();
    }
    // Zero-supply fallback: farmer requests saved while no owner was available (contain phone numbers)
    match /pending_demand_requests/{id} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create, update: if signedIn() && smallDoc();
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && smallDoc();
      allow delete: if false;
    }
  }
}
