rules_version = '2';

// Agri-Share Firestore rules (class pilot)
// - Anyone can browse machine listings and the diesel / province settings.
// - Bookings, live requests, Agri-Market posts and member profiles contain names and
//   phone numbers, so only signed-in members can read or write them.
// - Members can only create or edit their own profile.
// Limitation: any signed-in member can still edit shared records (the admin PIN in the
// app is a demo lock). Before a real launch, give admins a custom claim and check it here.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function smallDoc() { return request.resource.data.size() < 80; }

    match /machinery_listings/{id} {
      allow read: if true;
      allow create, update: if signedIn() && smallDoc();
      allow delete: if signedIn();
    }
    match /admin_settings/{id} {
      allow read: if true;
      allow write: if signedIn() && smallDoc();
    }
    match /bookings/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && smallDoc();
    }
    match /indrive_requests/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && smallDoc();
    }
    match /mandi_crops/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && smallDoc();
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && smallDoc();
      allow delete: if false;
    }
  }
}
