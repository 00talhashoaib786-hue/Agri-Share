rules_version = '2';

// Agri-Share Firestore rules (production)
// - Anyone can browse approved machine listings and the diesel / province settings.
// - Bookings, live requests, Agri-Market posts, waiting demand and member profiles contain
//   names and phone numbers, so only signed-in members can read or write them.
// - Members can only create or edit their own profile.
// - Admin settings, the admin password hash, the team list and listing approval are
//   restricted to the founder (and team admins the founder authorises).
//   Admin emails must be verified, so nobody can claim the founder's address by
//   registering it with an unverified password account.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function smallDoc() { return request.resource.data.size() < 80; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    function isFounder() {
      return verified() && request.auth.token.email == '00talhashoaib786@gmail.com';
    }
    function teamDoc() { return /databases/$(database)/documents/admin_settings/team; }
    function isTeamAdmin() {
      return verified() && exists(teamDoc())
        && request.auth.token.email.lower() in get(teamDoc()).data.emails;
    }
    function isAdmin() { return isFounder() || isTeamAdmin(); }

    match /machinery_listings/{id} {
      // public sees approved listings only; owners also see their own pending/rejected ones; admins see all.
      // (the app queries "status == approved" plus "ownerUid == me", because rules are not filters)
      allow read: if resource.data.get('status', '') == 'approved'
        || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid)
        || isAdmin();
      // new listings go live instantly ("approved") but unverified; the creator must be the owner
      // owner contact details never go on this public document (see listing_contacts)
      allow create: if signedIn() && smallDoc() && (isAdmin()
        || (request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status in ['approved', 'pending']
            && request.resource.data.get('isVerified', false) == false
            && !request.resource.data.keys().hasAny(['ownerEmail', 'ownerPhone'])));
      // only the owner (by uid) or an admin may change a listing; owners can never verify, approve or reject
      allow update: if signedIn() && smallDoc() && (isAdmin()
        || (resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.get('ownerUid', '') == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewedAt', 'isVerified', 'verifiedAt', 'ownerEmail', 'ownerPhone'])));
      allow delete: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
    }

    // admin_settings/pilot    diesel rate and active provinces (admins write)
    // admin_settings/security admin password hash (admins read, founder writes)
    // admin_settings/team     authorised team admin emails (signed-in read, founder writes)
    match /admin_settings/{id} {
      allow read: if (id == 'security' && isAdmin())
        || (id == 'team' && signedIn())
        || !(id in ['security', 'team']);
      allow write: if smallDoc() && (
        (id in ['security', 'team'] && isFounder())
        || (!(id in ['security', 'team']) && isAdmin()));
    }

    match /bookings/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && smallDoc();
    }
    // renter email / phone never go on this shared document (see request_contacts)
    match /indrive_requests/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && smallDoc() && !request.resource.data.keys().hasAny(['renterEmail', 'renterPhone']);
      allow update: if signedIn() && smallDoc()
        && (isFounder() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['renterEmail', 'renterPhone']));
    }
    // Renter contact for an Apni Boli request: the renter, the owner whose offer was accepted, and the founder
    match /request_contacts/{requestId} {
      allow create: if signedIn() && smallDoc() && (isFounder() || request.resource.data.renterUid == request.auth.uid);
      allow read: if isFounder() || (signedIn() && (resource.data.renterUid == request.auth.uid
        || resource.data.get('acceptedOwnerUid', '') == request.auth.uid));
      allow update: if signedIn() && smallDoc() && (isFounder()
        || (resource.data.renterUid == request.auth.uid && request.resource.data.renterUid == request.auth.uid));
      allow delete: if isFounder();
    }
    // Crop posts hold the seller's phone and JazzCash/EasyPaisa wallet number, so they stay members-only.
    // (Signed-out visitors no longer subscribe to private collections, so there is no permission-denied noise.)
    match /mandi_crops/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && smallDoc();
    }
    // Zero-supply fallback: farmer requests saved while no owner was available (contain phone numbers)
    match /pending_demand_requests/{id} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create, update: if signedIn() && smallDoc();
    }
    // Private owner contact for a listing (phone, email): only that owner and the founder
    match /listing_contacts/{listingId} {
      allow create: if signedIn() && smallDoc() && (isFounder() || request.resource.data.ownerUid == request.auth.uid);
      allow read, update, delete: if isFounder() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
    // Farmers with no machine within 25-100 km: any member can file their own lead; only the founder reads/manages
    match /unmatched_farmer_leads/{id} {
      allow create: if signedIn() && smallDoc() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isFounder();
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && smallDoc();
      allow delete: if false;
    }
  }
}
