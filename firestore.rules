rules_version = '2';

// Agri-Share Firestore rules (production)
// - Anyone can browse approved machine listings and the diesel / province settings.
// - Bookings, live requests, Agri-Market posts, waiting demand and member profiles contain
//   names and phone numbers, so only signed-in members can read or write them.
// - Members can only create or edit their own profile.
// - Admin settings, the admin password hash, the team list and listing approval are
//   restricted to the founder (and team admins the founder authorises).
//   Admin emails must be verified, so nobody can claim the founder's address by
//   registering it with an unverified password account.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function smallDoc() { return request.resource.data.size() < 80; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    function isFounder() {
      return verified() && request.auth.token.email == '00talhashoaib786@gmail.com';
    }
    function teamDoc() { return /databases/$(database)/documents/admin_settings/team; }
    function isTeamAdmin() {
      return verified() && exists(teamDoc())
        && request.auth.token.email.lower() in get(teamDoc()).data.emails;
    }
    function isAdmin() { return isFounder() || isTeamAdmin(); }

    match /machinery_listings/{id} {
      // public sees approved listings only; owners also see their own pending/rejected ones; admins see all.
      // (the app queries "status == approved" plus "ownerUid == me", because rules are not filters)
      allow read: if resource.data.get('status', '') == 'approved'
        || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid)
        || isAdmin();
      // new listings go live instantly ("approved") but unverified; the creator must be the owner
      // owner contact details never go on this public document (see listing_contacts)
      allow create: if signedIn() && smallDoc() && (isAdmin()
        || (request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status in ['approved', 'pending']
            && request.resource.data.get('isVerified', false) == false
            && !request.resource.data.keys().hasAny(['ownerEmail', 'ownerPhone'])));
      // only the owner (by uid) or an admin may change a listing; owners can never verify, approve or reject
      allow update: if signedIn() && smallDoc() && (isAdmin()
        || (resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.get('ownerUid', '') == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewedAt', 'isVerified', 'verifiedAt', 'ownerEmail', 'ownerPhone'])));
      allow delete: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
    }

    // app_settings/fuel_rates       founder's manual fuel price override { override, diesel, petrol, updatedAt, updatedBy }
    // app_settings/company_payment  Agri-Share official collection account shown on every bill
    //   { bankName, accountTitle, iban, jazzcash, easypaisa, raast, updatedAt, updatedBy }
    // Everyone may read them (bills show the account before sign-in); only the founder may change them.
    function companyOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['bankName', 'accountTitle', 'iban', 'jazzcash', 'easypaisa', 'raast', 'updatedAt', 'updatedBy'])
        && d.get('bankName', '') is string && d.get('bankName', '').size() <= 60
        && d.get('accountTitle', '') is string && d.get('accountTitle', '').size() <= 60
        && d.get('iban', '') is string && d.get('iban', '').size() <= 60
        && d.get('jazzcash', '') is string && d.get('jazzcash', '').size() <= 60
        && d.get('easypaisa', '') is string && d.get('easypaisa', '').size() <= 60
        && d.get('raast', '') is string && d.get('raast', '').size() <= 60;
    }
    match /app_settings/{id} {
      allow read: if true;
      allow create, update: if isFounder() && smallDoc()
        && (id != 'fuel_rates' || (request.resource.data.get('diesel', 0) is number
            && request.resource.data.get('diesel', 0) >= 150 && request.resource.data.get('diesel', 0) <= 600
            && request.resource.data.get('petrol', 0) is number
            && request.resource.data.get('petrol', 0) >= 150 && request.resource.data.get('petrol', 0) <= 600))
        && (id != 'company_payment' || companyOk());
      allow delete: if isFounder();
    }

    // ---------------- Deal parties (machinery bookings and land leases) ----------------
    // The farmer / tenant and the owner come from the deal document itself, never from what the client sends.
    function bookingAt(dealId) { return get(/databases/$(database)/documents/bookings/$(dealId)).data; }
    function landAt(dealId) { return get(/databases/$(database)/documents/land_bookings/$(dealId)).data; }
    function dealParties(kind, dealId) {
      return kind == 'land'
        ? [landAt(dealId).get('tenantUid', ''), landAt(dealId).get('ownerUid', '')]
        : [bookingAt(dealId).get('renterUid', ''), bookingAt(dealId).get('ownerUid', '')];
    }
    // the writer is a party, and the doc's "uids" (who may read it) are only that deal's farmer and owner
    function partyWrite(kind, dealId, uids) {
      return request.auth.uid in dealParties(kind, dealId) && dealParties(kind, dealId).hasAll(uids);
    }

    // Commission receipts: one per deal, id "booking_<id>" or "land_<id>". The farmer or owner uploads
    // (status "pending"); only the founder marks it "verified". Readable by that deal's parties and the founder.
    function receiptOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['dealKey', 'kind', 'dealId', 'amount', 'photo', 'ref', 'uids', 'ownerUid', 'byUid', 'byName', 'status', 'createdAt', 'updatedAt', 'verifiedAt', 'verifiedBy'])
        && d.kind in ['booking', 'land'] && d.dealId is string && id == d.kind + '_' + d.dealId && d.dealKey == id
        && d.status in ['pending', 'verified']
        && d.amount is number && d.amount >= 0 && d.amount <= 100000000
        && d.photo is string && d.photo.size() <= 170000
        && d.get('ref', '') is string && d.get('ref', '').size() <= 120
        && d.uids is list && d.uids.size() >= 1 && d.uids.size() <= 2;
    }
    match /commission_receipts/{id} {
      allow read: if isFounder() || (signedIn() && request.auth.uid in resource.data.uids);
      allow create: if signedIn() && receiptOk(id) && (isFounder()
        || (request.resource.data.status == 'pending' && request.resource.data.byUid == request.auth.uid
            && partyWrite(request.resource.data.kind, request.resource.data.dealId, request.resource.data.uids)));
      // a party may replace the receipt until the founder verifies it; they can never verify it themselves
      allow update: if signedIn() && receiptOk(id) && (isFounder()
        || (request.auth.uid in resource.data.uids && resource.data.status != 'verified'
            && request.resource.data.status == 'pending' && request.resource.data.byUid == request.auth.uid
            && request.resource.data.uids == resource.data.uids
            && request.resource.data.get('verifiedBy', '') == ''));
      allow delete: if isFounder();
    }

    // Photo / video work and handover proofs. Only the deal's farmer / tenant, its owner and the founder
    // can read or add them. Proofs are never edited (a record of what happened); only the founder deletes.
    function proofOk(kind) {
      let d = request.resource.data;
      return d.keys().hasOnly(['dealId', 'kind', 'stage', 'photo', 'video', 'videoUrl', 'note', 'uids', 'byUid', 'byName', 'byRole', 'createdAt'])
        && d.kind == kind && d.dealId is string
        && d.stage in ['before', 'after', 'meter', 'land']
        && d.byUid == request.auth.uid
        && d.uids is list && d.uids.size() >= 1 && d.uids.size() <= 2
        && d.get('photo', '') is string && d.get('photo', '').size() <= 170000
        && d.get('video', '') is string && d.get('video', '').size() <= 900000
        && d.get('videoUrl', '') is string && d.get('videoUrl', '').size() <= 500
        && d.get('note', '') is string && d.get('note', '').size() <= 300
        && (d.get('photo', '') != '' || d.get('video', '') != '' || d.get('videoUrl', '') != '');
    }
    match /booking_proofs/{id} {
      allow read: if isFounder() || (signedIn() && request.auth.uid in resource.data.uids);
      allow create: if signedIn() && proofOk('booking')
        && (isFounder() || partyWrite('booking', request.resource.data.dealId, request.resource.data.uids));
      allow update: if false;
      allow delete: if isFounder();
    }
    match /land_proofs/{id} {
      allow read: if isFounder() || (signedIn() && request.auth.uid in resource.data.uids);
      allow create: if signedIn() && proofOk('land')
        && (isFounder() || partyWrite('land', request.resource.data.dealId, request.resource.data.uids));
      allow update: if false;
      allow delete: if isFounder();
    }

    // admin_settings/pilot    diesel rate and active provinces (admins write)
    // admin_settings/security admin password hash (admins read, founder writes)
    // admin_settings/team     authorised team admin emails (signed-in read, founder writes)
    match /admin_settings/{id} {
      allow read: if (id == 'security' && isAdmin())
        || (id == 'team' && signedIn())
        || !(id in ['security', 'team']);
      allow write: if smallDoc() && (
        (id in ['security', 'team'] && isFounder())
        || (!(id in ['security', 'team']) && isAdmin()));
    }

    // renter email / phone never go on this shared document (see booking_contacts)
    match /bookings/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && smallDoc() && !request.resource.data.keys().hasAny(['renterEmail', 'renterPhone']);
      allow update: if signedIn() && smallDoc()
        && (isFounder() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['renterEmail', 'renterPhone']));
    }
    // Renter contact for a booking: the renter, the machine's owner (ownerUid) and the founder
    match /booking_contacts/{bookingId} {
      allow create: if signedIn() && smallDoc() && (isFounder() || request.resource.data.renterUid == request.auth.uid);
      allow read: if isFounder() || (signedIn() && (resource.data.renterUid == request.auth.uid
        || resource.data.get('ownerUid', '') == request.auth.uid));
      allow update: if signedIn() && smallDoc() && (isFounder()
        || (resource.data.renterUid == request.auth.uid && request.resource.data.renterUid == request.auth.uid));
      allow delete: if isFounder();
    }
    // renter email / phone never go on this shared document (see request_contacts)
    match /indrive_requests/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && smallDoc() && !request.resource.data.keys().hasAny(['renterEmail', 'renterPhone']);
      allow update: if signedIn() && smallDoc()
        && (isFounder() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['renterEmail', 'renterPhone']));
    }
    // Renter contact for an Apni Boli request: the renter, the owner whose offer was accepted, and the founder
    match /request_contacts/{requestId} {
      allow create: if signedIn() && smallDoc() && (isFounder() || request.resource.data.renterUid == request.auth.uid);
      allow read: if isFounder() || (signedIn() && (resource.data.renterUid == request.auth.uid
        || resource.data.get('acceptedOwnerUid', '') == request.auth.uid));
      allow update: if signedIn() && smallDoc() && (isFounder()
        || (resource.data.renterUid == request.auth.uid && request.resource.data.renterUid == request.auth.uid));
      allow delete: if isFounder();
    }
    // Crop posts: members-only, and seller email / phone / wallet number live in crop_contacts (below).
    match /mandi_crops/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && smallDoc() && !request.resource.data.keys().hasAny(['sellerEmail', 'sellerPhone', 'walletNo']);
      allow update: if signedIn() && smallDoc()
        && (isFounder() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerEmail', 'sellerPhone', 'walletNo']));
    }
    // Seller contact for a crop post (email, wallet / phone number): only the seller and the founder
    match /crop_contacts/{cropId} {
      allow create: if signedIn() && smallDoc() && (isFounder() || request.resource.data.sellerUid == request.auth.uid);
      allow read: if isFounder() || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow update: if signedIn() && smallDoc() && (isFounder()
        || (resource.data.sellerUid == request.auth.uid && request.resource.data.sellerUid == request.auth.uid));
      allow delete: if isFounder();
    }
    // Zero-supply fallback: farmer requests saved while no owner was available (contain phone numbers)
    // renter email / phone never go on this shared document (see demand_contacts)
    match /pending_demand_requests/{id} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create: if signedIn() && smallDoc() && !request.resource.data.keys().hasAny(['renterEmail', 'renterPhone']);
      allow update: if signedIn() && smallDoc()
        && (isFounder() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['renterEmail', 'renterPhone']));
    }
    // Renter contact for a waiting-demand ticket: the renter, the owner assigned to it, and the founder
    match /demand_contacts/{demandId} {
      allow create: if signedIn() && smallDoc() && (isFounder() || request.resource.data.renterUid == request.auth.uid);
      allow read: if isFounder() || (signedIn() && (resource.data.renterUid == request.auth.uid
        || resource.data.get('assignedOwnerUid', '') == request.auth.uid));
      allow update: if signedIn() && smallDoc() && (isFounder()
        || (resource.data.renterUid == request.auth.uid && request.resource.data.renterUid == request.auth.uid
            && request.resource.data.get('assignedOwnerUid', '') == resource.data.get('assignedOwnerUid', '')));
      allow delete: if isFounder();
    }
    // Private owner contact for a listing (phone, email): only that owner and the founder
    match /listing_contacts/{listingId} {
      allow create: if signedIn() && smallDoc() && (isFounder() || request.resource.data.ownerUid == request.auth.uid);
      allow read, update, delete: if isFounder() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
    // Farmers with no machine within 25-100 km: any member can file their own lead; only the founder reads/manages
    match /unmatched_farmer_leads/{id} {
      allow create: if signedIn() && smallDoc() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isFounder();
    }
    // Profiles hold email and phone: each member reads only their own; the founder reads all
    // ---------------- Thaikay Te Zameen (land leasing) ----------------
    // Land listings: public sees approved only; the owner sees their own; admins see all. Instant live but unverified.
    match /land_listings/{id} {
      allow read: if resource.data.get('status', '') == 'approved'
        || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid)
        || isAdmin();
      allow create: if signedIn() && smallDoc() && (isAdmin()
        || (request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == 'approved'
            && request.resource.data.get('isVerified', false) == false
            && !request.resource.data.keys().hasAny(['ownerEmail', 'ownerPhone'])));
      allow update: if signedIn() && smallDoc() && (isAdmin()
        || (resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.get('ownerUid', '') == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isVerified', 'verifiedAt', 'ownerEmail', 'ownerPhone'])));
      allow delete: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
    }
    // "Zameen Ki Boli": members can read (owners in the district send offers); renter contact lives elsewhere
    match /land_requests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && smallDoc() && request.resource.data.renterUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['renterEmail', 'renterPhone']);
      allow update: if signedIn() && smallDoc()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['renterEmail', 'renterPhone', 'renterUid']);
      allow delete: if isAdmin() || (signedIn() && resource.data.renterUid == request.auth.uid);
    }
    // Land leases: only the land owner, the tenant and admins
    match /land_bookings/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.tenantUid == request.auth.uid));
      allow create: if signedIn() && smallDoc() && request.resource.data.tenantUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['ownerEmail', 'ownerPhone', 'renterEmail', 'renterPhone']);
      allow update: if signedIn() && smallDoc() && (isAdmin()
        || ((resource.data.ownerUid == request.auth.uid || resource.data.tenantUid == request.auth.uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'tenantUid', 'ownerEmail', 'ownerPhone', 'renterEmail', 'renterPhone'])));
      allow delete: if isAdmin();
    }
    // Land owner contact: the owner, tenants whose lease the owner accepted (acceptedUids), and the founder
    match /land_contacts/{listingId} {
      allow create: if signedIn() && smallDoc() && (isFounder() || request.resource.data.ownerUid == request.auth.uid);
      allow read: if isFounder() || (signedIn() && (resource.data.ownerUid == request.auth.uid
        || request.auth.uid in resource.data.get('acceptedUids', [])));
      allow update: if signedIn() && smallDoc() && (isFounder()
        || (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid));
      allow delete: if isFounder();
    }
    // Tenant contact for a land demand or lease request: the tenant, the accepted land owner (acceptedUid), and the founder
    match /land_request_contacts/{requestId} {
      allow create: if signedIn() && smallDoc() && (isFounder() || request.resource.data.renterUid == request.auth.uid);
      allow read: if isFounder() || (signedIn() && (resource.data.renterUid == request.auth.uid
        || resource.data.get('acceptedUid', '') == request.auth.uid));
      allow update: if signedIn() && smallDoc() && (isFounder()
        || (resource.data.renterUid == request.auth.uid && request.resource.data.renterUid == request.auth.uid));
      allow delete: if isFounder();
    }
    // private per-member preferences: the "Clear -> History" archive (lists of cleared request keys)
    match /user_prefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['owner', 'admin', 'updatedAt'])
        && request.resource.data.get('owner', []) is list && request.resource.data.get('owner', []).size() <= 400
        && request.resource.data.get('admin', []) is list && request.resource.data.get('admin', []).size() <= 400;
      allow delete: if false;
    }
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isFounder();
      allow create, update: if ((signedIn() && request.auth.uid == uid) || isFounder()) && smallDoc();
      allow delete: if false;
    }
  }
}
