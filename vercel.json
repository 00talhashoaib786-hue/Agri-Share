{
  "functions": {
    "api/gemini.js": { "maxDuration": 30 },
    "api/notify-lead.js": { "maxDuration": 10 },
    "api/fuel-rates.js": { "maxDuration": 20 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!assets/).*)\\.(jpg|jpeg|png|webp|avif|gif|svg|ico|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/api/((?!fuel-rates).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/api/fuel-rates",
      "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=43200, stale-while-revalidate=86400" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|google[^/]*\\.html$|sitemap\\.xml$|robots\\.txt$).*)", "destination": "/index.html" }
  ]
}
